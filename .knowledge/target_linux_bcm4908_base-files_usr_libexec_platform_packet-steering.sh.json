{"is_source_file": true, "format": "sh", "description": "This script configures packet steering and interrupt localization settings based on system configuration such as the number of CPUs and flow offloading options. It interacts with UCI configuration system and system files to set network related parameters.", "external_files": ["/proc/cpuinfo", "/sys/class/net/eth0/queues/rx-0/rps_cpus", "/sys/class/net/br-lan/queues/rx-0/rps_cpus"], "external_methods": ["uci -q get network.@globals[0].packet_steering", "uci -q get firewall.@defaults[0].flow_offloading", "uci -q get firewall.@defaults[0].flow_offloading_hw"], "published": [], "classes": [], "methods": [{"name": "main", "description": "Main execution for setting packet steering parameters based on UCI configuration and system CPU info."}], "calls": ["uci -q get network.@globals[0].packet_steering", "grep -c \"^processor.*:\" /proc/cpuinfo", "uci -q get firewall.@defaults[0].flow_offloading", "uci -q get firewall.@defaults[0].flow_offloading_hw", "echo $rps_eth0 > /sys/class/net/eth0/queues/rx-0/rps_cpus", "echo $rps_br_lan > /sys/class/net/br-lan/queues/rx-0/rps_cpus"], "search-terms": ["packet_steering", "flow_offloading", "rps_cpus", "network configuration", "shell script", "BCM4908"], "state": 2, "file_id": 785, "knowledge_revision": 2813, "git_revision": "f06bd5bdb8e131a566d0f0068835296112f69915", "hash": "8587872fcfdfc15c6e10b3a9b1473db6", "format-version": 4, "code-base-name": "prplos-314849", "filename": "target/linux/bcm4908/base-files/usr/libexec/platform/packet-steering.sh", "revision_history": [{"2813": "f06bd5bdb8e131a566d0f0068835296112f69915"}]}